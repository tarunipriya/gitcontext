# Read-only GitHub personal access token, used to fetch PRs and issues via the GitHub REST API
GITHUB_TOKEN=

# Local directory where ingested repositories are cloned
REPOS_DIR=./data/repos

# URL of the Qdrant vector database instance
QDRANT_URL=http://localhost:6333

# API key for the LLM provider used to generate answers
LLM_API_KEY=

# Optional model override (defaults to gemini-3.5-flash; fallback defaults to gemini-3.8-flash)
# LLM_MODEL=gemini-3.5-flash

